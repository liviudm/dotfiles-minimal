# Font
font-family = JetBrainsMono Nerd Font
font-size = 13

# Theme
theme = dracula

# Window
macos-titlebar-style = transparent
window-padding-x = 10
window-padding-y = 10
background-opacity = 1.0
macos-option-as-alt = left

# Behavior
# Every new surface (window, tab, split) runs the tmux session picker;
# cancel it for a plain shell. See ~/.local/bin/ghostty-tmux.
command = ~/.local/bin/ghostty-tmux
shell-integration = detect
shell-integration-features = cursor,sudo,title
copy-on-select = clipboard
quit-after-last-window-closed = true
confirm-close-surface = true
mouse-hide-while-typing = true

# Clipboard — OSC 52 writes allowed; reads prompt
clipboard-read = ask
clipboard-write = allow
clipboard-paste-protection = true

# Keybindings
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+w=close_surface
keybind = cmd+t=new_tab

# Optional machine-local settings (not tracked).
config-file = ?config.local
